# Nusxa oling: cp .env.example .env  va qiymatlarni to'ldiring. `.env` repozitoriyga tushmaydi (.gitignore).

# PostgreSQL (ishlab chiqarishda majburiy). Lokal docker-compose uchun: postgresql://tera:tera@localhost:5433/tera
TERA_DATABASE_URL=postgresql://tera:CHANGE_ME@localhost:5433/tera

# Redis (ixtiyoriy, lekin ishlab chiqarishda tavsiya etiladi: tezlik cheklovi, kesh, xabarlar oqimi, qulf).
# Bo'sh bo'lsa, xotiradagi kesh ishlatiladi (faqat bitta jarayonli ishlab chiqish uchun).
TERA_REDIS_URL=redis://localhost:6380/0

# Token imzosi uchun maxfiy kalit, kamida 32 belgi. Yaratish:  python -c "import secrets; print(secrets.token_urlsafe(48))"
TERA_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_OF_32+_CHARS

# Ixtiyoriy
TERA_TOKEN_TTL_SECONDS=43200
TERA_DB_POOL_MIN=1
TERA_DB_POOL_MAX=10

# Ixtiyoriy: faqat Telegram xabarnoma xizmatini ishga tushirganda kerak.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
